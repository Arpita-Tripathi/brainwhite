# Copy to .env and fill in locally. Never commit .env.
# Placeholders only. Items marked [Open] are not decided yet.

APP_ENV=local
LOG_LEVEL=INFO

# Postgres (local docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brainwhite

# Object storage (MinIO, local)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=brainwhite-dev

# LLM provider [Open: provider, model, budget]
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_MONTHLY_BUDGET_USD=

# GitHub App (dev) [values come from the GitHub App settings page]
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Auth [Open: dev stub or managed provider]
AUTH_MODE=dev_stub
SESSION_SECRET=

# Ephemeral processing
EPHEMERAL_DIR=.ephemeral
EPHEMERAL_TTL_SECONDS=3600
